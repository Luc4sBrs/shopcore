# =============================================================================
# ShopCore — Variáveis de ambiente
# =============================================================================
# Banco de dados: Supabase (PostgreSQL hospedado)
DB_URL=jdbc:postgresql://db.SEU_PROJETO_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
FLYWAY_USER=postgres
FLYWAY_PASSWORD=your-database-password

# Supabase (Auth / API)
SUPABASE_URL=https://SEU_PROJETO_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_VALOR
SUPABASE_SECRET_KEY=sb_secret_SEU_VALOR
SUPABASE_JWKS_URL=https://SEU_PROJETO_REF.supabase.co/auth/v1/.well-known/jwks.json

# JWT
JWT_SECRET=change-me-use-a-long-random-secret-key-in-production
JWT_EXPIRATION=86400000

# Frontend
VITE_API_URL=http://localhost:8090/api
